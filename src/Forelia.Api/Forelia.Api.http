@host = http://localhost:5080

GET {{host}}/

### API em execução
GET {{host}}/health/live

### Conexão com PostgreSQL
GET {{host}}/health/ready

### Importação operacional válida (201 na primeira chamada, 409 na repetição)
POST {{host}}/api/importacoes/operacional
Content-Type: multipart/form-data; boundary=forelia-boundary

--forelia-boundary
Content-Disposition: form-data; name="arquivo"; filename="operacional.csv"
Content-Type: text/csv

< ../../examples/csv/01_base/operacional.csv
--forelia-boundary--

> {%
    if (response.status === 201 || response.status === 409) {
        client.global.set("arquivoOperacionalId", response.body.id || response.body.importacaoExistenteId);
    }
%}

### Importação contábil válida
POST {{host}}/api/importacoes/contabil
Content-Type: multipart/form-data; boundary=forelia-boundary

--forelia-boundary
Content-Disposition: form-data; name="arquivo"; filename="contabil.csv"
Content-Type: text/csv

< ../../examples/csv/01_base/contabil.csv
--forelia-boundary--

> {%
    if (response.status === 201 || response.status === 409) {
        client.global.set("arquivoContabilId", response.body.id || response.body.importacaoExistenteId);
    }
%}

### Campos inválidos: retorna 422 com os erros, sem persistir registros
POST {{host}}/api/importacoes/operacional
Content-Type: multipart/form-data; boundary=forelia-boundary

--forelia-boundary
Content-Disposition: form-data; name="arquivo"; filename="operacional_campos_invalidos.csv"
Content-Type: text/csv

< ../../examples/csv/06_invalidos/operacional_campos_invalidos.csv
--forelia-boundary--

### Conciliar os arquivos importados acima (201 nova execução, 200 resultado existente)
POST {{host}}/api/conciliacoes
Content-Type: application/json

{
  "arquivoOperacionalId": "{{arquivoOperacionalId}}",
  "arquivoContabilId": "{{arquivoContabilId}}"
}

> {%
    if (response.status === 201 || response.status === 200) {
        client.global.set("conciliacaoId", response.body.id);
        client.test("Cenário base: 4 conciliados, 3 divergentes e 2 sem correspondência", function () {
            client.assert(response.body.status === "CONCLUIDA");
            client.assert(response.body.paresConciliados === 4);
            client.assert(response.body.paresDivergentes === 3);
            client.assert(response.body.totalItens === 9);
        });
    }
%}

### Resumo da conciliação base
GET {{host}}/api/conciliacoes/{{conciliacaoId}}

### Itens da conciliação base, incluindo divergências de valor e data
GET {{host}}/api/conciliacoes/{{conciliacaoId}}/itens?pagina=1&tamanhoPagina=20

> {%
    if (response.status === 200) {
        const item = response.body.itens.find(item => item.idOperacao === "OP004");
        client.global.set("itemAnaliseId", item.id);
    }
%}

### Histórico de execuções
GET {{host}}/api/conciliacoes?pagina=1&tamanhoPagina=20

### Importar arquivo contábil corrigido
POST {{host}}/api/importacoes/contabil
Content-Type: multipart/form-data; boundary=forelia-boundary

--forelia-boundary
Content-Disposition: form-data; name="arquivo"; filename="contabil_corrigido.csv"
Content-Type: text/csv

< ../../examples/csv/02_correcao/contabil_corrigido.csv
--forelia-boundary--

> {%
    if (response.status === 201 || response.status === 409) {
        client.global.set("arquivoContabilCorrigidoId", response.body.id || response.body.importacaoExistenteId);
    }
%}

### Conciliar correção sem sobrescrever a execução base
POST {{host}}/api/conciliacoes
Content-Type: application/json

{
  "arquivoOperacionalId": "{{arquivoOperacionalId}}",
  "arquivoContabilId": "{{arquivoContabilCorrigidoId}}"
}

> {%
    if (response.status === 201 || response.status === 200) {
        client.test("Correção: 8 pares conciliados e taxa de 100%", function () {
            client.assert(response.body.paresConciliados === 8);
            client.assert(response.body.taxaConciliacao === 100);
            client.assert(response.body.id !== client.global.get("conciliacaoId"));
        });
    }
%}

### Iniciar ou reabrir a análise de OP004 sem alterar a divergência financeira
PATCH {{host}}/api/conciliacoes/{{conciliacaoId}}/itens/{{itemAnaliseId}}/analise
Content-Type: application/json

{"situacao": "EM_ANALISE"}

> {%
    client.test("Situação alterada; resultado financeiro preservado", function () {
        client.assert(response.status === 200);
        client.assert(response.body.situacaoAnalise === "EM_ANALISE");
        client.assert(response.body.resultado === "DIVERGENTE");
        client.assert(response.body.divergencias.length === 2);
    });
%}

### Adicionar observação (cada execução desta requisição cria uma nova observação)
POST {{host}}/api/conciliacoes/{{conciliacaoId}}/itens/{{itemAnaliseId}}/observacoes
Content-Type: application/json

{"texto": "Investigar diferença de valor e data no exemplo OP004.", "analista": "analista-teste"}

> {%
    client.test("Observação criada com identidade não autenticada", function () {
        client.assert(response.status === 201);
        client.assert(response.body.identidadeAutenticada === false);
        client.assert(response.body.avisoIdentidade === "Identidade não autenticada");
    });
    if (response.status === 201) client.global.set("observacaoId", response.body.id);
%}

### Concluir a investigação; OP004 continua financeiramente divergente
PATCH {{host}}/api/conciliacoes/{{conciliacaoId}}/itens/{{itemAnaliseId}}/analise
Content-Type: application/json

{"situacao": "ANALISADA"}

> {%
    client.test("Análise concluída sem transformar o resultado em conciliado", function () {
        client.assert(response.status === 200);
        client.assert(response.body.situacaoAnalise === "ANALISADA");
        client.assert(response.body.resultado === "DIVERGENTE");
    });
%}

### Consultar o item e sua situação de análise
GET {{host}}/api/conciliacoes/{{conciliacaoId}}/itens/{{itemAnaliseId}}

### Histórico das observações, da mais antiga para a mais recente
GET {{host}}/api/conciliacoes/{{conciliacaoId}}/itens/{{itemAnaliseId}}/observacoes?pagina=1&tamanhoPagina=20

### Consultar a observação criada
GET {{host}}/api/conciliacoes/{{conciliacaoId}}/itens/{{itemAnaliseId}}/observacoes/{{observacaoId}}

### Filtrar por resultado e paginar somente os itens divergentes
GET {{host}}/api/conciliacoes/{{conciliacaoId}}/itens?resultado=DIVERGENTE&pagina=1&tamanhoPagina=2

> {%
    client.test("Filtro aplicado antes da contagem e da paginação", function () {
        client.assert(response.status === 200);
        client.assert(response.body.total === 3);
        client.assert(response.body.itens.length === 2);
        client.assert(response.body.itens[0].idOperacao === "OP002");
        client.assert(response.body.itens[1].idOperacao === "OP003");
    });
%}

### Combinar identificador, resultado e situação atual da análise
GET {{host}}/api/conciliacoes/{{conciliacaoId}}/itens?idOperacao=OP004&resultado=DIVERGENTE&situacaoAnalise=ANALISADA

> {%
    client.test("Filtros combinados com E", function () {
        client.assert(response.status === 200);
        client.assert(response.body.total === 1);
        client.assert(response.body.itens[0].idOperacao === "OP004");
        client.assert(response.body.itens[0].situacaoAnalise === "ANALISADA");
    });
%}

### Período inclusivo pela data operacional: OP003, OP004 e OP005
GET {{host}}/api/conciliacoes/{{conciliacaoId}}/itens?dataInicial=2026-10-03&dataFinal=2026-10-05

> {%
    client.test("Limites do período inclusivos", function () {
        client.assert(response.status === 200);
        client.assert(response.body.total === 3);
        client.assert(response.body.itens.map(item => item.idOperacao).join(",") === "OP003,OP004,OP005");
    });
%}

### OP009 não possui registro operacional: usar sua data contábil
GET {{host}}/api/conciliacoes/{{conciliacaoId}}/itens?dataOperacao=2026-10-09

> {%
    client.test("Fallback para a data contábil quando não existe operação", function () {
        client.assert(response.status === 200);
        client.assert(response.body.total === 1);
        client.assert(response.body.itens[0].idOperacao === "OP009");
    });
%}

### Período invertido: retornar 400
GET {{host}}/api/conciliacoes/{{conciliacaoId}}/itens?dataInicial=2026-10-05&dataFinal=2026-10-03

> {%
    client.test("Filtro inválido rejeitado", function () {
        client.assert(response.status === 400);
        client.assert(response.body.codigo === "FILTRO_INVALIDO");
    });
%}
