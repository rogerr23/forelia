# Sistema operacional e configurações pessoais dos editores
.DS_Store
.idea/
*.user
*.suo
*.DotSettings.user
/frontend/.vscode/*
!/frontend/.vscode/extensions.json

# Backend — arquivos gerados pelo .NET
**/bin/
**/obj/

# Testes — resultados e cobertura
**/TestResults/
*.trx
*.coverage
*.coveragexml

# Frontend — dependências, builds e cache do TypeScript
**/node_modules/
/frontend/dist/
/frontend/dist-ssr/
*.tsbuildinfo

# Frontend — logs locais
/frontend/logs/
/frontend/**/*.log
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*
/frontend/pnpm-debug.log*
/frontend/lerna-debug.log*

# Ambiente local — manter os modelos de configuração versionáveis
.env
.env.*
!.env.example

# Documentação de referência local — guia de desenvolvimento versionado
/docs/*
!/docs/DESENVOLVIMENTO.md
